# Kopieren nach .env.local — .env.local wird NIE committed.
# Pflichtangaben werden beim Start via Zod validiert (apps/web/lib/env.ts).

# --- Infrastruktur (Pflicht ab Phase 0) -------------------------------------
DATABASE_URL=postgres://macro:macro@localhost:5432/macrodeck
# Optional. Ohne Redis nutzt der Cache aus §10 Layer 2 Postgres — gleiche
# Semantik, anderer Speicher. Siehe docs/adr/0001-cache-backend.md.
# Eine gesetzte, aber ungueltige URL bleibt ein harter Fehler.
REDIS_URL=

# --- Provider-Keys (Pflicht ab Phase 1, siehe apps/web/lib/env.ts) ----------
# Pflicht. Kostenlos, sofort aktiv: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Optional (Demo-Plan). Erhoeht Stabilitaet + Rate-Limit.
# https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY=

# Optional. Nur wenn Coinglass-Abo vorhanden. Ohne Key rendert die
# Derivate-Seite den Eigen-Ingest mit Hinweis "modelliert" — nie Fantasiedaten.
# https://www.coinglass.com/pricing
COINGLASS_API_KEY=

# --- Verhalten --------------------------------------------------------------
ENABLE_WS_INGEST=false
LOG_LEVEL=info
